DATABASE_URL=postgres://localhost:5432/metoncampus_dev
REDIS_URL=redis://localhost:6379
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Allowed university email suffix(es), comma separated
ALLOWED_EMAIL_SUFFIXES=.edu.ng
# Presence TTL in seconds for "On Campus Now"
PRESENCE_TTL_SECONDS=90

# Web push (browser notifications). Generate a pair with `bun run push:keys` in apps/api. Without both, push is off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@metoncampus.xyz

# Online rooms (voice on LiveKit Cloud). Values come from the LiveKit Cloud project settings; never commit the secret.
# Without all three, online rooms are unavailable.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Email (Resend). Leave RESEND_API_KEY empty in dev to print codes to the API console.
RESEND_API_KEY=
EMAIL_FROM="Met On Campus <noreply@yes.metoncampus.xyz>"
# Marketing site (apps/marketing): where /volunteers applications are emailed. Uses RESEND_API_KEY and EMAIL_FROM above.
# Without it, dev prints applications to the console; production refuses them (503) rather than losing them silently.
VOLUNTEER_INBOX_EMAIL=
# Set true only behind a proxy that overwrites X-Forwarded-For (for per-IP rate limits)
# The marketing site's /volunteers form reads it too: without it only a global 30-per-hour cap applies; with it, 5 per address as well.
TRUST_PROXY=false

# --- Platform (staff) app ---------------------------------------------------------------------
# /admin/* on the API is a 404 unless ADMIN_API_TOKEN is set. Generate each value with the command shown.
ADMIN_API_TOKEN=            # openssl rand -base64 36 | tr -d '/+=' | cut -c1-48   (same value in apps/platform)
ADMIN_ENCRYPTION_KEY=       # openssl rand -base64 32   (encrypts staff authenticator secrets; losing it means re-enrolling staff)
PLATFORM_ADMIN_EMAILS=      # comma-separated staff addresses; the ONLY addresses that can ever have an account
PLATFORM_URL=http://localhost:3100
