# Public site settings (these are not secrets; they are baked into the build).
NEXT_PUBLIC_SITE_URL=https://metoncampus.xyz
NEXT_PUBLIC_APP_URL=https://app.metoncampus.xyz
# Shown in the footer and on the universities, terms and privacy pages. Defaults to hello@metoncampus.xyz; set this only to override it.
NEXT_PUBLIC_CONTACT_EMAIL=hello@metoncampus.xyz
