# Where the Met On Campus API lives. Server-side only: the browser never talks to the API from this app.
ADMIN_API_URL=http://localhost:3001
# Must equal ADMIN_API_TOKEN on the API (32+ random characters). Never prefix with NEXT_PUBLIC_.
ADMIN_API_TOKEN=

# Optional: show Railway deployments on the Health page. Create a project token in Railway.
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
