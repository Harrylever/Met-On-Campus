{
  "name": "metoncampus",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '*' dev",
    "dev:api": "bun run --filter @moc/api dev",
    "dev:web": "bun run --filter @moc/web dev",
    "db:generate": "bun run --filter @moc/db generate",
    "db:migrate": "bun run --filter @moc/db migrate",
    "typecheck": "bun run --filter '*' typecheck",
    "db:seed": "bun run --filter @moc/db seed",
    "test": "bun run --filter @moc/api test",
    "test:setup": "createdb metoncampus_test || true"
  },
  "devDependencies": {
    "railway": "^3.17.0"
  }
}
